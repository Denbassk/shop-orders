// ============================================================
// НОРМАЛІЗАЦІЯ АДРЕС - точна копія логіки legacy-скриптів
// ============================================================

// Хлібний скрипт зберігає адресу в скороченому вигляді:
// "м. Харків вул. Астрономічна, 44 Г" -> "Астрономічна, 44 г"
function shortenAddress_(address) {
  var s = String(address || '').trim();
  s = s.replace(/^м\.\s*Харків\s*/i, '');
  s = s.replace(/^(вул\.|вулиця|пр-т|проспект|просп\.|пров\.|провулок|пл\.|площа|шосе)\s*/i, '');
  s = s.replace(/\s+/g, ' ').trim();
  if (!s) return '';
  return s.charAt(0).toUpperCase() + s.slice(1).toLowerCase();
}

// Ключ для порівняння адрес незалежно від написання
function addrKey_(address) {
  return String(address || '').toLowerCase()
    .replace(/[\u2019''`"]/g, '')
    .replace(/\b(м|вул|вулиця|пр\-?т|проспект|просп|пров|провулок|пл|площа|шосе|харків)\b/g, ' ')
    .replace(/[^a-zа-яіїєґ0-9\/]+/gi, ' ')
    .replace(/\s+/g, ' ')
    .trim();
}